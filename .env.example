# ══════════════════════════════════════════════════════
# 环境变量模板
#
# 用法：复制为 .env 并填入真实值
#   cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 忽略，切勿提交真实私钥。
# ══════════════════════════════════════════════════════

# ─── 链上网络 ───
# Monad 测试网（默认）
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# ─── 参与方私钥 ───
# 不配置任一私钥时，平台运行在 mock 模式（仅本地演示，不发真实交易）

# 账户一：甲方 / 部署者 / 采集者
# 从 https://testnet.monad.xyz/faucet 获取测试币
PRIVATE_KEY=

# 账户二：乙方
# 必须是独立私钥 —— 合约校验 msg.sender == provider，
# 乙方签署与提交交付需要用它签名
PRIVATE_KEY_2=

# ─── 受控依赖安装 ───
# 验收时安装 npm 依赖所允许的 registry 白名单
DEP_ALLOWED_REGISTRIES=https://registry.npmjs.org,https://registry.npmmirror.com

# 单次依赖安装硬超时（毫秒）
DEP_INSTALL_TIMEOUT_MS=120000

# ─── 交付物存储 ───
# 上传交付物的落盘位置（默认 <项目根>/deliveries）
# DELIVERY_STORAGE_ROOT=/var/lib/milestone/deliveries

# ─── 服务端口 ───
PORT=4000